*.py[cod]
*$py.class
*.pyd

# C extensions & OS files
*.so
*.dylib
.DS_Store
Thumbs.db
desktop.ini

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Heavy distribution archives (exceeding GitHub 100MB limit)
dist/
*.zip
*.tar.gz
*.7z

# Local backups and scratch work
backup/
scratch/

